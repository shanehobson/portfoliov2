{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:blog",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "prebuild": "npm run build:blog",
    "build:blog": "node scripts/build-blog.mjs",
    "import:medium": "node scripts/import-medium.mjs",
    "lint": "eslint .",
    "optimize:images": "bash scripts/optimize-images.sh",
    "optimize:videos": "bash scripts/optimize-videos.sh",
    "preview": "vite preview",
    "test:a11y": "vite preview --port 4173 --strictPort & SERVER=$!; sleep 2; npx --yes @axe-core/cli http://localhost:4173/ http://localhost:4173/blog/ http://localhost:4173/blog/how-react-renders-components-a-deep-dive-into-fiber/; STATUS=$?; kill $SERVER; exit $STATUS",
    "deploy": "npm run build && npm --prefix cdk run deploy",
    "media:push": "npm --prefix cdk run media:push",
    "media:pull": "npm --prefix cdk run media:pull"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.84.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.1",
    "shiki": "^4.4.3",
    "turndown": "^7.2.4",
    "vite": "^6.1.0"
  }
}
